        if isinstance(op,dict) and 'requestBody' in op:
            rb=op.get('requestBody',{})
            schema=rb.get('content',{}).get('application/json',{}).get('schema',{})
            ref=schema.get('\$ref','')
            if 'InitTranscription' in ref:
                schemas=d.get('components',{}).get('schemas',{})
                init=schemas.get('InitTranscriptionRequest',{})
                audio=init.get('properties',{}).get('audio_url',{})
                print(f'audio_url: {audio}')
