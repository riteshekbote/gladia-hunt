import base64, urllib.parse
vals = [
  'eyJ1cmwiOiIvYXBpa2V5cyc9cmVkaXJlY3RfdG89aHR0cHM6XyUyRiUyRmV2aWwuZXhhbXBsZS5jb20ifQ==',
  'eyJ1cmwiOiIvYXBpa2V5cz9yZWRpcmVjdF90bz1odHRwcyUzQSUyRiUyRmV2aWwuZXhhbXBsZS5jb20ifQ==',
  'eyJ1cmwiOiIvdHJhbnNjcmlwdGlvbnM/ZXhwb3J0X3RvPWh0dHBzOi8vZXZpbC5leGFtcGxlLmNvbSIifQ==',
]
for v in vals:
    try:
        decoded = base64.b64decode(v + '==')
        print(f'{v[:40]}... -> {decoded}')
    except:
        pass
# Also decode the actual cookie values from the probes
cookie_apikeys = 'eyJ1cmwiOiIvYXBpa2V5cz9yZWRpcmVjdF90bz1odHRwcyUzQSUyRiUyRmV2aWwuZXhhbXBsZS5jb20ifQ=='
cookie_trans = 'eyJ1cmwiOiIvdHJhbnNjcmlwdGlvbnM/ZXhwb3J0X3RvPWh0dHBzOi8vZXZpbC5leGFtcGxlLmNvbSB9'
print()
print('apikeys cookie:', base64.b64decode(cookie_apikeys))
print('transcriptions cookie:', base64.b64decode('eyJ1cmwiOiIvdHJhbnNjcmlwdGlvbnM/cmVkaXJlY3RfdG89aHR0cHMlM0ElMkYlMkZldmlsLmV4YW1wbGUuY29tIn0='))
