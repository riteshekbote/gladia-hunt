import re
from pathlib import Path
text = Path("reports/hypotheses-laguna.txt").read_text(errors="ignore")
STOP = re.compile(r'^\[(HYP|PARKED|FINAL|NEXT|LEARN|RISK|NEW|CHANGED|CONF|PRIO)\]')
KV = re.compile(r'^([a-z_]+):\s*(.*)$', re.I)
def parse_blocks(text, model):
    blocks, lines, i = [], text.splitlines(), 0
    while i < len(lines):
        m = re.match(r'^\[HYP\]\s*(.*)$', lines[i].strip())
        if not m:
            i += 1; continue
        b = {"title": m.group(1).strip(), "model": model}; j = i+1
        while j < len(lines):
            l = lines[j].strip()
            if not l or STOP.match(l): break
            kv = KV.match(l)
            if kv: b[kv.group(1).lower()] = kv.group(2).strip()
            j += 1
        blocks.append(b); i = j
    return blocks
mb = re.search(r'\(model\s+(\w+)\)', text)
blocks = parse_blocks(text, mb.group(1) if mb else "laguna")
print("parsed HYP blocks:", len(blocks))
for b in blocks:
    c = b.get("confidence"); cls=b.get("class"); a=b.get("asset")
    print(f"  - conf={c} class={cls} asset={a}: {b['title'][:60]}")
# verify REJECTED asset capture
rejected=[m.group(1) for m in re.finditer(r'^\[LEARN\]\s*REJECTED\s+\S+\s+@\s+(\S+)', text, re.M)]
print("REJECTED assets:", rejected)
parked=[l.strip() for l in text.splitlines() if l.startswith("[PARKED]")]
print("PARKED blocks:", len(parked))
