function isUrl(s: string): boolean {
  try {
    const u = new URL(s)
    return u.protocol === 'http:' || u.protocol === 'https:'
  } catch {
    return false
  }
}

function resolveFlowDeadlineMs(
  timeout: number | null | undefined,
  configuredMs: number
): number | null {
  if (timeout === null) return null
  if (timeout !== undefined) return timeout
  return configuredMs
}

