import urllib.request, ssl, time, hashlib

ctx = ssl.create_default_context()
probes = [
    ("openapi", "https://api.gladia.io/openapi.json"),
    ("openapi_etag", "https://api.gladia.io/openapi.json"),
    ("health", "https://api.gladia.io/health"),
    ("models", "https://api.gladia.io/v1/models"),
    ("pre_recorded", "https://api.gladia.io/v2/pre-recorded"),
    ("transcription", "https://api.gladia.io/v2/transcription"),
    ("gladia_io_bbr", "https://gladia.io/bug-bounty-report"),
    ("github_user", "https://api.github.com/users/alexisbouchez"),
    ("github_repo", "https://api.github.com/repos/alexisbouchez/gladia.ts"),
    ("npm_gladia", "https://registry.npmjs.org/gladia"),
    ("npm_gladia_pkg", "https://registry.npmjs.org/gladia/-/gladia-0.1.3.tgz"),
    ("app_signin", "https://app.gladia.io/signin?redirect_to=https://evil.example.com"),
    ("app_auth_cb", "https://app.gladia.io/auth/google/callback"),
    ("app_dashboard", "https://app.gladia.io/dashboard"),
]

def probe(url, head_only=False, want_headers=False):
    req = urllib.request.Request(url, method='HEAD', headers={'User-Agent': 'Mozilla/5.0 (passive research probe)'})
    if want_headers:
        req = urllib.request.Request(url, method='GET', headers={'User-Agent': 'Mozilla/5.0 (passive research probe)'})
    try:
        with urllib.request.urlopen(req, timeout=12, context=ctx) as r:
            body = r.read(1500) if not head_only or want_headers else b''
            return f"{r.status} len={r.headers.get('Content-Length','?')} type={r.headers.get('Content-Type','')[:30]} etag={r.headers.get('ETag','none')[:40]} xpb={r.headers.get('X-Powered-By','none')[:10]}"
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code} {e.reason} len={e.headers.get('Content-Length','?')}"
    except Exception as e:
        return f"ERR {str(e)[:60]}"

import urllib.error
for label, url in probes:
    time.sleep(1.1)
    result = probe(url)
    print(f"[{label}] {url} -> {result}")
