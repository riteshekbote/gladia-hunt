import urllib.request, ssl, time, urllib.error

ctx = ssl.create_default_context()

# OPTIONS probe for x-powered-by differential
time.sleep(1.1)
req = urllib.request.Request("https://api.gladia.io/v2/transcription", method='OPTIONS',
    headers={'User-Agent': 'Mozilla/5.0', 'Origin': 'https://evil.example.com',
             'Access-Control-Request-Method': 'POST',
             'Access-Control-Request-Headers': 'x-gladia-key'})
try:
    with urllib.request.urlopen(req, timeout=12, context=ctx) as r:
        print(f"OPTIONS /v2/transcription -> {r.status} xpb={r.headers.get('X-Powered-By','none')} acao={r.headers.get('Access-Control-Allow-Origin','none')} acah={r.headers.get('Access-Control-Allow-Headers','none')}")
except urllib.error.HTTPError as e:
    print(f"OPTIONS /v2/transcription -> HTTP {e.code} xpb={e.headers.get('X-Powered-By','none')} acao={e.headers.get('Access-Control-Allow-Origin','none')}")
    body = e.read(200)
    print(f"  body: {body[:80]}")
except Exception as e:
    print(f"OPTIONS /v2/transcription -> ERR {str(e)[:60]}")

# Verify signin reflection body for form action
time.sleep(1.1)
req2 = urllib.request.Request("https://app.gladia.io/signin?redirect_to=https://evil.example.com",
    method='GET', headers={'User-Agent': 'Mozilla/5.0 (passive research probe)'})
try:
    with urllib.request.urlopen(req2, timeout=12, context=ctx) as r:
        body = r.read(30000).decode('utf-8', errors='ignore')
        # Search for form action with reflected redirect_to
        import re
        form_matches = re.findall(r'<form[^>]+action="[^"]*redirect_to[^"]*"[^>]*>', body)
        csp_matches = re.findall(r'form-action', body, re.IGNORECASE)
        print(f"GET /signin -> {r.status} len={len(body)}")
        print(f"  form-action reflection: {form_matches[0][:120] if form_matches else 'NOT FOUND'}")
        print(f"  CSP form-action directives: {len(csp_matches)}")
except Exception as e:
    print(f"GET /signin -> ERR {str(e)[:60]}")
