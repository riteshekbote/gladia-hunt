def find_x(o,path=''):
    out=[]
    if isinstance(o,dict):
        for k,v in o.items():
            if k.startswith('x-'): out.append(path+'/'+k)
            out+=find_x(v,path+'/'+k)
    elif isinstance(o,list):
        for i,v in enumerate(o): out+=find_x(v,path+'/'+str(i))
    return out
xs=find_x(d['components'])
print('x- extensions in components:',set(xs))
